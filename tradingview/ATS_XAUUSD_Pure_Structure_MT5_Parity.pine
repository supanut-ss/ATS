//@version=6
strategy("ATS XAUUSD Pure Structure — MT5 Parity", overlay = true, pyramiding = 0,
     initial_capital = 100000, default_qty_type = strategy.fixed, default_qty_value = 0.05,
     calc_on_every_tick = true, process_orders_on_close = true,
     commission_type = strategy.commission.percent, commission_value = 0.0)

// This strategy mirrors the rule-based part of ATS_MT5_EA_VSA_Tuned_six_correctness_fixes.mq5.
// TradingView has no historical bid/ask stream. Backtests therefore use the chart close and
// syminfo.mintick as the MT5 entry-price and SYMBOL_POINT proxies.

//──────────────────────────────────────────────────────────────────────────────
// Inputs
//──────────────────────────────────────────────────────────────────────────────
string G_STRUCTURE = "Structure / Entry"
int pivotLen       = input.int(5, "Pivot length", minval = 1, group = G_STRUCTURE)
float slBufferPts  = input.float(1.0, "Structural SL buffer (points)", minval = 0, group = G_STRUCTURE)
int maxSLPts       = input.int(12000, "Maximum structural SL (points)", minval = 1, group = G_STRUCTURE)
float pdThreshold  = input.float(0.618, "Premium / Discount threshold", minval = 0.5, maxval = 1.0, step = 0.001, group = G_STRUCTURE)
string entryMode   = input.string("Discount only", "Entry mode", options = ["Discount only", "Any FVG/OB", "Strict ICT"], group = G_STRUCTURE)
bool requireCHoCH  = input.bool(false, "Require directional CHoCH", group = G_STRUCTURE)
int bosConfirmBars = input.int(2, "BOS confirmation bars", minval = 1, group = G_STRUCTURE)
int bosMaxPending  = input.int(4, "BOS maximum pending bars", minval = 1, group = G_STRUCTURE)
int fvgMaxAge      = input.int(48, "FVG maximum age (bars)", minval = 1, group = G_STRUCTURE)
int obMaxAge       = input.int(48, "Order-block maximum age (bars)", minval = 1, group = G_STRUCTURE)

string G_RISK = "Risk / Position"
bool useFixedSL    = input.bool(true, "Use fixed SL", group = G_RISK)
int fixedSLPts     = input.int(7000, "Fixed SL (points)", minval = 1, group = G_RISK)
float fixedQty     = input.float(0.05, "Order quantity", minval = 0.01, step = 0.01, group = G_RISK)
bool normalizeQty  = input.bool(true, "Raise quantity to TradingView symbol minimum", tooltip = "TradingView quantities are contracts/units, not universally MT5 lots. If 0.05 is below syminfo.mincontract, use the symbol minimum so the broker emulator can create an order.", group = G_RISK)
bool useDailyGuard = input.bool(true, "Use daily-loss guard", group = G_RISK)
int maxDailyLosses = input.int(3, "Maximum losing trades per day", minval = 1, group = G_RISK)
string dailyTZ     = input.string("Asia/Bangkok", "Daily reset timezone", group = G_RISK)

string G_PA = "Price Action"
float paBodyMin   = input.float(0.35, "Minimum body / range", minval = 0, maxval = 1, step = 0.01, group = G_PA)
float paWickMax   = input.float(0.60, "Maximum adverse wick / range", minval = 0, maxval = 1, step = 0.01, group = G_PA)
float paCloseMin  = input.float(0.45, "Minimum close position", minval = 0, maxval = 1, step = 0.01, group = G_PA)
bool requireEngulf = input.bool(true, "Require engulfing close", group = G_PA)

string G_TREND = "Trend Filters"
bool useEMA         = input.bool(true, "Use chart EMA", group = G_TREND)
int emaLen          = input.int(200, "Chart EMA length", minval = 1, group = G_TREND)
bool useH1          = input.bool(true, "Use H1 data", group = G_TREND)
int h1Len           = input.int(21, "H1 EMA length", minval = 1, group = G_TREND)
bool useH4          = input.bool(true, "Use H4 data", group = G_TREND)
int h4Len           = input.int(21, "H4 EMA length", minval = 1, group = G_TREND)
bool filterCounter  = input.bool(false, "Reject counter-trend entries", group = G_TREND)

string G_FILTERS = "News / Volume / Range Filters"
bool useNewsFilter  = input.bool(true, "Use news-session filter", group = G_FILTERS)
string newsSession1 = input.session("0300-0500:23456", "News block 1", group = G_FILTERS)
string newsSession2 = input.session("1930-2030:6", "News block 2", group = G_FILTERS)
string newsTZ        = input.string("Asia/Bangkok", "News timezone", group = G_FILTERS)
bool useVolFilter   = input.bool(true, "Use volume-spike filter", group = G_FILTERS)
float volSpikeMult  = input.float(2.2, "Volume-spike multiplier", minval = 0.1, step = 0.1, group = G_FILTERS)
int volSmaLen       = input.int(20, "Volume SMA length", minval = 1, group = G_FILTERS)
int volLookback     = input.int(1, "Volume-spike lookback", minval = 1, maxval = 20, group = G_FILTERS)
bool useADX         = input.bool(true, "Use ADX filter", group = G_FILTERS)
int adxLen          = input.int(14, "ADX length", minval = 1, group = G_FILTERS)
float adxMin        = input.float(18.0, "Minimum ADX", minval = 0, step = 0.5, group = G_FILTERS)
bool useChop        = input.bool(true, "Use Choppiness filter", group = G_FILTERS)
int chopLen         = input.int(14, "Choppiness length", minval = 2, group = G_FILTERS)
float chopMax       = input.float(62.0, "Maximum Choppiness", minval = 0, maxval = 100, step = 0.5, group = G_FILTERS)
bool useATR         = input.bool(true, "Use ATR-ratio filter", group = G_FILTERS)
float atrMinRatio   = input.float(0.75, "Minimum ATR / ATR-SMA50", minval = 0, step = 0.05, group = G_FILTERS)
bool useCooldown    = input.bool(true, "Cooldown after a loss", group = G_FILTERS)
int cooldownMinutes = input.int(45, "Loss cooldown (minutes)", minval = 1, group = G_FILTERS)

string G_EXIT = "Early Exit"
bool useEarlyExit      = input.bool(true, "Use early exit", group = G_EXIT)
bool exitOppositeCHoCH = input.bool(true, "Exit on opposite CHoCH", group = G_EXIT)
bool exitStructBreak   = input.bool(true, "Exit on defensive pivot break", group = G_EXIT)
int exitConfirmBars    = input.int(2, "Bad-signal confirmation bars", minval = 1, group = G_EXIT)
bool exitHTFReversal   = input.bool(false, "Exit when enabled H1/H4 both reverse", group = G_EXIT)
bool useTimeStop       = input.bool(true, "Use losing time stop", group = G_EXIT)
int timeStopBars       = input.int(20, "Time-stop bars", minval = 1, group = G_EXIT)
float earlyExitRiskR   = input.float(0.65, "Emergency early-exit loss (R)", minval = 0.01, maxval = 1.0, step = 0.05, group = G_EXIT)

string G_MANAGE = "Break-even / Trailing / TP"
int bePts            = input.int(8000, "Break-even trigger (points)", minval = 1, group = G_MANAGE)
int beLowVolPts      = input.int(5000, "Low-volume BE trigger (points)", minval = 1, group = G_MANAGE)
bool adaptiveBE      = input.bool(true, "Use adaptive BE", group = G_MANAGE)
int trailTriggerPts  = input.int(15000, "Trailing trigger (points)", minval = 1, group = G_MANAGE)
int trailLockPts     = input.int(7000, "Trailing step / minimum lock (points)", minval = 1, group = G_MANAGE)
bool steppedTrail    = input.bool(true, "Use stepped trailing", group = G_MANAGE)
int takeProfitPts    = input.int(42000, "Take profit (points)", minval = 1, group = G_MANAGE)
bool useForceClose   = input.bool(true, "Use forced close session", group = G_MANAGE)
string forceSession  = input.session("0400-0405:23456", "Forced close session", group = G_MANAGE)
string forceTZ       = input.string("Asia/Bangkok", "Forced close timezone", group = G_MANAGE)

string G_DISPLAY = "Display / Alerts"
bool showZones      = input.bool(true, "Show active FVG / OB zones", group = G_DISPLAY)
bool sendJSONAlerts = input.bool(false, "Send secret-free JSON alerts", group = G_DISPLAY)
bool showDiagnostics = input.bool(true, "Show entry diagnostics", group = G_DISPLAY)

float point = syminfo.mintick
// TradingView quantity means contracts/shares/lots/units depending on the chart symbol.
// It is not guaranteed to have the same monetary meaning as an MT5 lot.
float symbolMinQty = na(syminfo.mincontract) or syminfo.mincontract <= 0 ? fixedQty : syminfo.mincontract
float qty = normalizeQty ? math.max(fixedQty, symbolMinQty) : fixedQty

f_inSession(string sessionValue, string timezoneValue) =>
    not na(time(timeframe.period, sessionValue, timezoneValue))

f_json(string action, float entryPrice, float stopPrice, float targetPrice) =>
    '{"action":"' + action + '","symbol":"' + syminfo.ticker + '","timeframe":"' + timeframe.period +
      '","price":' + str.tostring(entryPrice, format.mintick) + ',"sl":' + str.tostring(stopPrice, format.mintick) +
      ',"tp":' + str.tostring(targetPrice, format.mintick) + ',"qty":' + str.tostring(qty) + '}'

f_closeJson(float closePrice) =>
    '{"action":"CLOSE","symbol":"' + syminfo.ticker + '","timeframe":"' + timeframe.period +
      '","price":' + str.tostring(closePrice, format.mintick) + '}'

//──────────────────────────────────────────────────────────────────────────────
// Non-repainting chart and higher-timeframe filters
//──────────────────────────────────────────────────────────────────────────────
float chartEMA = ta.ema(close, emaLen)
[h1Close, h1EMA] = request.security(syminfo.tickerid, "60", [close[1], ta.ema(close, h1Len)[1]], lookahead = barmerge.lookahead_on)
[h4Close, h4EMA] = request.security(syminfo.tickerid, "240", [close[1], ta.ema(close, h4Len)[1]], lookahead = barmerge.lookahead_on)

bool h1DataOK = not useH1 or (not na(h1Close) and not na(h1EMA))
bool h4DataOK = not useH4 or (not na(h4Close) and not na(h4EMA))
bool htfDataOK = h1DataOK and h4DataOK
bool h1Bull = not useH1 or h1Close > h1EMA
bool h1Bear = not useH1 or h1Close < h1EMA
bool h4Bull = not useH4 or h4Close > h4EMA
bool h4Bear = not useH4 or h4Close < h4EMA
bool longIsCountertrend = (useH1 and h1Bear) or (useH4 and h4Bear)
bool shortIsCountertrend = (useH1 and h1Bull) or (useH4 and h4Bull)
bool longHTFOK  = htfDataOK and (not filterCounter or not longIsCountertrend)
bool shortHTFOK = htfDataOK and (not filterCounter or not shortIsCountertrend)
bool longEMAOK  = not useEMA or (not na(chartEMA) and close > chartEMA)
bool shortEMAOK = not useEMA or (not na(chartEMA) and close < chartEMA)

//──────────────────────────────────────────────────────────────────────────────
// Pivots, CHoCH and confirmed BOS state machine
//──────────────────────────────────────────────────────────────────────────────
float pivotHigh = ta.pivothigh(high, pivotLen, pivotLen)
float pivotLow  = ta.pivotlow(low, pivotLen, pivotLen)
var float previousPivotHigh = na
var float lastPivotHigh = na
var float previousPivotLow = na
var float lastPivotLow = na
var bool bullishCHoCH = false
var bool bearishCHoCH = false
var int trend = 0
var int pendingBOSDirection = 0
var float pendingBOSLevel = na
var int pendingBOSConfirmations = 0
var int pendingBOSAge = 0
bool bullishBOS = false
bool bearishBOS = false

if barstate.isconfirmed
    if not na(pivotHigh)
        previousPivotHigh := lastPivotHigh
        lastPivotHigh := pivotHigh
        if trend == 1 and not na(previousPivotHigh) and lastPivotHigh < previousPivotHigh
            bearishCHoCH := true
    if not na(pivotLow)
        previousPivotLow := lastPivotLow
        lastPivotLow := pivotLow
        if trend == -1 and not na(previousPivotLow) and lastPivotLow > previousPivotLow
            bullishCHoCH := true

    bool bosConfirmedNow = false
    if pendingBOSDirection != 0
        pendingBOSAge += 1
        bool stillBeyond = pendingBOSDirection == 1 ? close > pendingBOSLevel : close < pendingBOSLevel
        if not stillBeyond or pendingBOSAge > bosMaxPending
            pendingBOSDirection := 0
            pendingBOSLevel := na
            pendingBOSConfirmations := 0
            pendingBOSAge := 0
        else
            pendingBOSConfirmations += 1
            if pendingBOSConfirmations >= bosConfirmBars
                trend := pendingBOSDirection
                bullishBOS := trend == 1
                bearishBOS := trend == -1
                if bullishBOS
                    bearishCHoCH := false
                if bearishBOS
                    bullishCHoCH := false
                bosConfirmedNow := true
                pendingBOSDirection := 0
                pendingBOSLevel := na
                pendingBOSConfirmations := 0
                pendingBOSAge := 0

    if pendingBOSDirection == 0 and not bosConfirmedNow
        int candidateDirection = not na(lastPivotHigh) and close > lastPivotHigh ? 1 : not na(lastPivotLow) and close < lastPivotLow ? -1 : 0
        float candidateLevel = candidateDirection == 1 ? lastPivotHigh : candidateDirection == -1 ? lastPivotLow : na
        if candidateDirection != 0 and candidateDirection != trend
            if bosConfirmBars <= 1
                trend := candidateDirection
                bullishBOS := trend == 1
                bearishBOS := trend == -1
                if bullishBOS
                    bearishCHoCH := false
                if bearishBOS
                    bullishCHoCH := false
            else
                pendingBOSDirection := candidateDirection
                pendingBOSLevel := candidateLevel
                pendingBOSConfirmations := 1
                pendingBOSAge := 1

//──────────────────────────────────────────────────────────────────────────────
// Swing range and bounded FVG / order-block lifecycle
//──────────────────────────────────────────────────────────────────────────────
var float swingHigh = na
var float swingLow = na
var int previousTrend = 0
var float bullFVGLow = na
var float bullFVGHigh = na
var int bullFVGAge = -1
var float bearFVGLow = na
var float bearFVGHigh = na
var int bearFVGAge = -1
var float bullOBLow = na
var float bullOBHigh = na
var int bullOBAge = -1
var float bearOBLow = na
var float bearOBHigh = na
var int bearOBAge = -1
var bool touchedDiscount = false
var bool touchedPremium = false

if barstate.isconfirmed
    bool trendChanged = trend != previousTrend
    if trendChanged
        swingHigh := trend == 1 ? high : not na(lastPivotHigh) ? lastPivotHigh : high
        swingLow  := trend == -1 ? low : not na(lastPivotLow) ? lastPivotLow : low
        bullFVGLow := na
        bullFVGHigh := na
        bullFVGAge := -1
        bearFVGLow := na
        bearFVGHigh := na
        bearFVGAge := -1
        bullOBLow := na
        bullOBHigh := na
        bullOBAge := -1
        bearOBLow := na
        bearOBHigh := na
        bearOBAge := -1
        touchedDiscount := false
        touchedPremium := false
    else
        if trend == 1
            swingHigh := na(swingHigh) ? high : math.max(swingHigh, high)
            swingLow := na(swingLow) ? (not na(lastPivotLow) ? lastPivotLow : low) : swingLow
        if trend == -1
            swingLow := na(swingLow) ? low : math.min(swingLow, low)
            swingHigh := na(swingHigh) ? (not na(lastPivotHigh) ? lastPivotHigh : high) : swingHigh
    previousTrend := trend

    if bullFVGAge >= 0
        bullFVGAge += 1
        if bullFVGAge > fvgMaxAge or close < bullFVGLow
            bullFVGLow := na
            bullFVGHigh := na
            bullFVGAge := -1
    if bearFVGAge >= 0
        bearFVGAge += 1
        if bearFVGAge > fvgMaxAge or close > bearFVGHigh
            bearFVGLow := na
            bearFVGHigh := na
            bearFVGAge := -1
    if bullOBAge >= 0
        bullOBAge += 1
        if bullOBAge > obMaxAge or close < bullOBLow
            bullOBLow := na
            bullOBHigh := na
            bullOBAge := -1
    if bearOBAge >= 0
        bearOBAge += 1
        if bearOBAge > obMaxAge or close > bearOBHigh
            bearOBLow := na
            bearOBHigh := na
            bearOBAge := -1

    if bar_index >= 2
        if high[2] < low
            bullFVGLow := high[2]
            bullFVGHigh := low
            bullFVGAge := 0
        if low[2] > high
            bearFVGLow := high
            bearFVGHigh := low[2]
            bearFVGAge := 0
        if close[2] < open[2] and close > open and close > high[2]
            bullOBLow := low[2]
            bullOBHigh := high[2]
            bullOBAge := 0
        if close[2] > open[2] and close < open and close < low[2]
            bearOBLow := low[2]
            bearOBHigh := high[2]
            bearOBAge := 0

float swingRange = not na(swingHigh) and not na(swingLow) ? swingHigh - swingLow : na
float discountLevel = not na(swingRange) and swingRange > 0 ? swingLow + swingRange * pdThreshold : na
float premiumLevel  = not na(swingRange) and swingRange > 0 ? swingHigh - swingRange * pdThreshold : na

if barstate.isconfirmed
    if trend != 1 or strategy.position_size > 0
        touchedDiscount := false
    else if not na(discountLevel) and low <= discountLevel
        touchedDiscount := true
    if trend != -1 or strategy.position_size < 0
        touchedPremium := false
    else if not na(premiumLevel) and high >= premiumLevel
        touchedPremium := true

bool inBullFVG = bullFVGAge >= 0 and high >= bullFVGLow and low <= bullFVGHigh
bool inBearFVG = bearFVGAge >= 0 and high >= bearFVGLow and low <= bearFVGHigh
bool inBullOB  = bullOBAge >= 0 and high >= bullOBLow and low <= bullOBHigh
bool inBearOB  = bearOBAge >= 0 and high >= bearOBLow and low <= bearOBHigh
bool inLongZone = inBullFVG or inBullOB
bool inShortZone = inBearFVG or inBearOB
bool longLocationOK = entryMode == "Discount only" ? touchedDiscount : entryMode == "Any FVG/OB" ? (inLongZone or touchedDiscount) : touchedDiscount and inLongZone
bool shortLocationOK = entryMode == "Discount only" ? touchedPremium : entryMode == "Any FVG/OB" ? (inShortZone or touchedPremium) : touchedPremium and inShortZone

//──────────────────────────────────────────────────────────────────────────────
// Price action and market-condition filters
//──────────────────────────────────────────────────────────────────────────────
float candleRange = high - low
float candleBody = math.abs(close - open)
float bullAdverseWick = high - close
float bearAdverseWick = close - low
float bullClosePosition = candleRange > 0 ? (close - low) / candleRange : 0.0
float bearClosePosition = candleRange > 0 ? (high - close) / candleRange : 0.0
bool bullPA = candleRange > 0 and close > open and close[1] < open[1] and candleBody / candleRange >= paBodyMin and bullAdverseWick / candleRange <= paWickMax and bullClosePosition >= paCloseMin and (not requireEngulf or close > open[1])
bool bearPA = candleRange > 0 and close < open and close[1] > open[1] and candleBody / candleRange >= paBodyMin and bearAdverseWick / candleRange <= paWickMax and bearClosePosition >= paCloseMin and (not requireEngulf or close < open[1])

bool newsBlocked = useNewsFilter and (f_inSession(newsSession1, newsTZ) or f_inSession(newsSession2, newsTZ))
float volumeBaseline = ta.sma(volume[1], volSmaLen)
bool volumeBlocked = false
for i = 0 to volLookback - 1
    volumeBlocked := volumeBlocked or (not na(volume[i]) and not na(volumeBaseline[i]) and volume[i] > volumeBaseline[i] * volSpikeMult)
volumeBlocked := useVolFilter and volumeBlocked

[plusDI, minusDI, adxValue] = ta.dmi(adxLen, adxLen)
bool adxOK = not useADX or (not na(adxValue) and adxValue >= adxMin)
float trueRangeSum = math.sum(ta.tr(true), chopLen)
float chopRange = ta.highest(high, chopLen) - ta.lowest(low, chopLen)
float chopValue = chopRange > 0 ? 100.0 * math.log10(trueRangeSum / chopRange) / math.log10(chopLen) : na
bool chopOK = not useChop or (not na(chopValue) and chopValue <= chopMax)
float atrValue = ta.atr(14)
float atrAverage = ta.sma(atrValue, 50)
float atrRatio = not na(atrAverage) and atrAverage > 0 ? atrValue / atrAverage : na
bool atrOK = not useATR or (not na(atrRatio) and atrRatio >= atrMinRatio)

// Daily loss guard and cooldown use strategy-emulator closed-trade results.
var int dailyLosses = 0
var int currentDayKey = na
var int lastLosingExitTime = na
int dayKey = year(time, dailyTZ) * 10000 + month(time, dailyTZ) * 100 + dayofmonth(time, dailyTZ)
if na(currentDayKey) or dayKey != currentDayKey
    currentDayKey := dayKey
    dailyLosses := 0

bool justClosedTrade = ta.change(strategy.closedtrades) > 0
if justClosedTrade
    int lastTradeIndex = strategy.closedtrades - 1
    float lastTradeProfit = strategy.closedtrades.profit(lastTradeIndex)
    int lastTradeExitTime = strategy.closedtrades.exit_time(lastTradeIndex)
    int lastTradeDayKey = year(lastTradeExitTime, dailyTZ) * 10000 + month(lastTradeExitTime, dailyTZ) * 100 + dayofmonth(lastTradeExitTime, dailyTZ)
    if lastTradeProfit < 0
        if lastTradeDayKey == currentDayKey
            dailyLosses += 1
        lastLosingExitTime := lastTradeExitTime

bool dailyGuardOK = not useDailyGuard or dailyLosses < maxDailyLosses
bool cooldownOK = not useCooldown or na(lastLosingExitTime) or time_close - lastLosingExitTime >= cooldownMinutes * 60000
bool commonFiltersOK = not newsBlocked and not volumeBlocked and adxOK and chopOK and atrOK and dailyGuardOK and cooldownOK
bool forcedClose = useForceClose and f_inSession(forceSession, forceTZ)

//──────────────────────────────────────────────────────────────────────────────
// Entry and protective orders
//──────────────────────────────────────────────────────────────────────────────
bool longSignal = barstate.isconfirmed and strategy.position_size == 0 and trend == 1 and longLocationOK and bullPA and (not requireCHoCH or bullishCHoCH) and longEMAOK and longHTFOK and commonFiltersOK and not forcedClose
bool shortSignal = barstate.isconfirmed and strategy.position_size == 0 and trend == -1 and shortLocationOK and bearPA and (not requireCHoCH or bearishCHoCH) and shortEMAOK and shortHTFOK and commonFiltersOK and not forcedClose
var int generatedSignals = 0
if longSignal or shortSignal
    generatedSignals += 1

var float activeEntry = na
var float activeSL = na
var float activeTP = na
var float initialRisk = na
var float peakFavourablePrice = na
var int entryBar = na
var bool entryWasLowVolume = false
var int longBadBars = 0
var int shortBadBars = 0

if longSignal
    float rawStructuralSL = swingLow - slBufferPts * point
    if bullOBAge >= 0 and bullOBLow < rawStructuralSL
        rawStructuralSL := bullOBLow - slBufferPts * point
    float structuralRisk = close - rawStructuralSL
    float structuralSL = na(structuralRisk) or structuralRisk <= 0 or structuralRisk > maxSLPts * point ? close - maxSLPts * point : rawStructuralSL
    activeEntry := close
    activeSL := useFixedSL ? close - fixedSLPts * point : structuralSL
    activeTP := close + takeProfitPts * point
    initialRisk := close - activeSL
    peakFavourablePrice := close
    entryBar := bar_index
    entryWasLowVolume := not na(volumeBaseline) and volume < volumeBaseline
    longBadBars := 0
    shortBadBars := 0
    strategy.entry("Buy", strategy.long, qty = qty)
    strategy.exit("Buy Exit", "Buy", stop = activeSL, limit = activeTP)
    if sendJSONAlerts
        alert(f_json("BUY", activeEntry, activeSL, activeTP), alert.freq_once_per_bar_close)

if shortSignal
    float rawStructuralSL = swingHigh + slBufferPts * point
    if bearOBAge >= 0 and bearOBHigh > rawStructuralSL
        rawStructuralSL := bearOBHigh + slBufferPts * point
    float structuralRisk = rawStructuralSL - close
    float structuralSL = na(structuralRisk) or structuralRisk <= 0 or structuralRisk > maxSLPts * point ? close + maxSLPts * point : rawStructuralSL
    activeEntry := close
    activeSL := useFixedSL ? close + fixedSLPts * point : structuralSL
    activeTP := close - takeProfitPts * point
    initialRisk := activeSL - close
    peakFavourablePrice := close
    entryBar := bar_index
    entryWasLowVolume := not na(volumeBaseline) and volume < volumeBaseline
    longBadBars := 0
    shortBadBars := 0
    strategy.entry("Sell", strategy.short, qty = qty)
    strategy.exit("Sell Exit", "Sell", stop = activeSL, limit = activeTP)
    if sendJSONAlerts
        alert(f_json("SELL", activeEntry, activeSL, activeTP), alert.freq_once_per_bar_close)

bool newLong = strategy.position_size > 0 and strategy.position_size[1] <= 0
bool newShort = strategy.position_size < 0 and strategy.position_size[1] >= 0
if newLong
    activeEntry := strategy.position_avg_price
    activeSL := useFixedSL ? activeEntry - fixedSLPts * point : math.max(activeSL, activeEntry - maxSLPts * point)
    activeTP := activeEntry + takeProfitPts * point
    initialRisk := activeEntry - activeSL
    peakFavourablePrice := activeEntry
    entryBar := bar_index
if newShort
    activeEntry := strategy.position_avg_price
    activeSL := useFixedSL ? activeEntry + fixedSLPts * point : math.min(activeSL, activeEntry + maxSLPts * point)
    activeTP := activeEntry - takeProfitPts * point
    initialRisk := activeSL - activeEntry
    peakFavourablePrice := activeEntry
    entryBar := bar_index

//──────────────────────────────────────────────────────────────────────────────
// Every-tick BE/trailing and confirmed-bar early exit
//──────────────────────────────────────────────────────────────────────────────
bool earlyClose = false

if strategy.position_size > 0
    peakFavourablePrice := na(peakFavourablePrice) ? high : math.max(peakFavourablePrice, high)
    float profitDistance = peakFavourablePrice - activeEntry
    float beTrigger = adaptiveBE and entryWasLowVolume ? beLowVolPts * point : bePts * point
    float managedSL = activeSL
    if profitDistance >= trailTriggerPts * point
        float lockDistance = trailLockPts * point
        float stepMultiplier = math.floor(profitDistance / lockDistance)
        float lockedDistance = steppedTrail ? math.max(0.0, (stepMultiplier - 1.0) * lockDistance) : lockDistance
        managedSL := math.max(managedSL, activeEntry + lockedDistance)
    else if profitDistance >= beTrigger
        managedSL := math.max(managedSL, activeEntry + 10 * point)
    if managedSL > activeSL and managedSL < close
        activeSL := managedSL

    if barstate.isconfirmed
        bool htfReversed = exitHTFReversal and (useH1 or useH4) and htfDataOK and (not useH1 or h1Bear) and (not useH4 or h4Bear)
        bool badSignal = (exitOppositeCHoCH and bearishCHoCH) or (exitStructBreak and not na(lastPivotLow) and close < lastPivotLow) or htfReversed
        longBadBars := badSignal ? longBadBars + 1 : 0
        float adverseR = initialRisk > 0 ? math.max(0.0, activeEntry - close) / initialRisk : 0.0
        int heldBars = na(entryBar) ? 0 : bar_index - entryBar
        earlyClose := useEarlyExit and ((badSignal and (longBadBars >= exitConfirmBars or adverseR >= earlyExitRiskR)) or (useTimeStop and heldBars >= timeStopBars and close <= activeEntry))
    if forcedClose or earlyClose
        strategy.close("Buy", immediately = true, comment = forcedClose ? "Force close" : "Early exit")
    else
        strategy.exit("Buy Exit", "Buy", stop = activeSL, limit = activeTP)

if strategy.position_size < 0
    peakFavourablePrice := na(peakFavourablePrice) ? low : math.min(peakFavourablePrice, low)
    float profitDistance = activeEntry - peakFavourablePrice
    float beTrigger = adaptiveBE and entryWasLowVolume ? beLowVolPts * point : bePts * point
    float managedSL = activeSL
    if profitDistance >= trailTriggerPts * point
        float lockDistance = trailLockPts * point
        float stepMultiplier = math.floor(profitDistance / lockDistance)
        float lockedDistance = steppedTrail ? math.max(0.0, (stepMultiplier - 1.0) * lockDistance) : lockDistance
        managedSL := math.min(managedSL, activeEntry - lockedDistance)
    else if profitDistance >= beTrigger
        managedSL := math.min(managedSL, activeEntry - 10 * point)
    if managedSL < activeSL and managedSL > close
        activeSL := managedSL

    if barstate.isconfirmed
        bool htfReversed = exitHTFReversal and (useH1 or useH4) and htfDataOK and (not useH1 or h1Bull) and (not useH4 or h4Bull)
        bool badSignal = (exitOppositeCHoCH and bullishCHoCH) or (exitStructBreak and not na(lastPivotHigh) and close > lastPivotHigh) or htfReversed
        shortBadBars := badSignal ? shortBadBars + 1 : 0
        float adverseR = initialRisk > 0 ? math.max(0.0, close - activeEntry) / initialRisk : 0.0
        int heldBars = na(entryBar) ? 0 : bar_index - entryBar
        earlyClose := useEarlyExit and ((badSignal and (shortBadBars >= exitConfirmBars or adverseR >= earlyExitRiskR)) or (useTimeStop and heldBars >= timeStopBars and close >= activeEntry))
    if forcedClose or earlyClose
        strategy.close("Sell", immediately = true, comment = forcedClose ? "Force close" : "Early exit")
    else
        strategy.exit("Sell Exit", "Sell", stop = activeSL, limit = activeTP)

if strategy.position_size == 0 and strategy.position_size[1] != 0
    if sendJSONAlerts
        alert(f_closeJson(close), alert.freq_once_per_bar)
    activeEntry := na
    activeSL := na
    activeTP := na
    initialRisk := na
    peakFavourablePrice := na
    entryBar := na
    entryWasLowVolume := false
    longBadBars := 0
    shortBadBars := 0

//──────────────────────────────────────────────────────────────────────────────
// Visual diagnostics
//──────────────────────────────────────────────────────────────────────────────
plot(useEMA ? chartEMA : na, "EMA", color = color.orange, linewidth = 2)
plot(trend == 1 ? discountLevel : na, "Discount threshold", color = color.new(color.green, 45), style = plot.style_linebr)
plot(trend == -1 ? premiumLevel : na, "Premium threshold", color = color.new(color.red, 45), style = plot.style_linebr)
plot(showZones and bullFVGAge >= 0 ? bullFVGLow : na, "Bull FVG low", color = color.new(color.aqua, 45), style = plot.style_linebr)
plot(showZones and bullFVGAge >= 0 ? bullFVGHigh : na, "Bull FVG high", color = color.new(color.aqua, 45), style = plot.style_linebr)
plot(showZones and bearFVGAge >= 0 ? bearFVGLow : na, "Bear FVG low", color = color.new(color.fuchsia, 45), style = plot.style_linebr)
plot(showZones and bearFVGAge >= 0 ? bearFVGHigh : na, "Bear FVG high", color = color.new(color.fuchsia, 45), style = plot.style_linebr)
plot(showZones and bullOBAge >= 0 ? bullOBLow : na, "Bull OB low", color = color.new(color.lime, 60), style = plot.style_linebr)
plot(showZones and bullOBAge >= 0 ? bullOBHigh : na, "Bull OB high", color = color.new(color.lime, 60), style = plot.style_linebr)
plot(showZones and bearOBAge >= 0 ? bearOBLow : na, "Bear OB low", color = color.new(color.maroon, 45), style = plot.style_linebr)
plot(showZones and bearOBAge >= 0 ? bearOBHigh : na, "Bear OB high", color = color.new(color.maroon, 45), style = plot.style_linebr)
plot(strategy.position_size != 0 ? activeSL : na, "Active SL", color = color.red, linewidth = 2, style = plot.style_linebr)
plot(strategy.position_size != 0 ? activeTP : na, "Active TP", color = color.green, linewidth = 2, style = plot.style_linebr)
plotshape(bullishBOS, "Bullish BOS", shape.triangleup, location.belowbar, color.lime, size = size.tiny, text = "BOS")
plotshape(bearishBOS, "Bearish BOS", shape.triangledown, location.abovebar, color.red, size = size.tiny, text = "BOS")
plotshape(longSignal, "Long signal", shape.labelup, location.belowbar, color.green, text = "BUY", textcolor = color.white, size = size.tiny)
plotshape(shortSignal, "Short signal", shape.labeldown, location.abovebar, color.red, text = "SELL", textcolor = color.white, size = size.tiny)

// The table exposes the first currently failing gate. It makes a zero-trade
// backtest distinguishable from an order-size rejection without relaxing rules.
string longStatus = strategy.position_size != 0 ? "Position already open" : trend != 1 ? "Blocked: bullish BOS/trend" : not longLocationOK ? "Blocked: discount/FVG/OB" : not bullPA ? "Blocked: bullish PA" : requireCHoCH and not bullishCHoCH ? "Blocked: bullish CHoCH" : not longEMAOK ? "Blocked: EMA" : not longHTFOK ? "Blocked: HTF data/trend" : newsBlocked ? "Blocked: news session" : volumeBlocked ? "Blocked: volume spike" : not adxOK ? "Blocked: ADX" : not chopOK ? "Blocked: CHOP" : not atrOK ? "Blocked: ATR ratio" : not dailyGuardOK ? "Blocked: daily losses" : not cooldownOK ? "Blocked: cooldown" : forcedClose ? "Blocked: force-close session" : "Ready on closed bar"
string shortStatus = strategy.position_size != 0 ? "Position already open" : trend != -1 ? "Blocked: bearish BOS/trend" : not shortLocationOK ? "Blocked: premium/FVG/OB" : not bearPA ? "Blocked: bearish PA" : requireCHoCH and not bearishCHoCH ? "Blocked: bearish CHoCH" : not shortEMAOK ? "Blocked: EMA" : not shortHTFOK ? "Blocked: HTF data/trend" : newsBlocked ? "Blocked: news session" : volumeBlocked ? "Blocked: volume spike" : not adxOK ? "Blocked: ADX" : not chopOK ? "Blocked: CHOP" : not atrOK ? "Blocked: ATR ratio" : not dailyGuardOK ? "Blocked: daily losses" : not cooldownOK ? "Blocked: cooldown" : forcedClose ? "Blocked: force-close session" : "Ready on closed bar"
bool qtyBelowMinimum = fixedQty < symbolMinQty
string qtyStatus = str.tostring(fixedQty) + " requested / " + str.tostring(qty) + " effective / " + str.tostring(symbolMinQty) + " minimum"
string filterStatus = "ADX " + str.tostring(adxValue, "#.0") + " | CHOP " + str.tostring(chopValue, "#.0") + " | ATR " + str.tostring(atrRatio, "#.00")
var table diagnostics = table.new(position.top_right, 2, 7, border_width = 1)
if barstate.islast and showDiagnostics
    color panel = color.new(color.black, 15)
    table.cell(diagnostics, 0, 0, "ATS diagnostic", bgcolor = color.navy, text_color = color.white)
    table.cell(diagnostics, 1, 0, syminfo.ticker + " " + timeframe.period, bgcolor = color.navy, text_color = color.white)
    table.cell(diagnostics, 0, 1, "Quantity", bgcolor = panel, text_color = color.white)
    table.cell(diagnostics, 1, 1, qtyStatus, bgcolor = qtyBelowMinimum and not normalizeQty ? color.red : panel, text_color = color.white)
    table.cell(diagnostics, 0, 2, "Structure", bgcolor = panel, text_color = color.white)
    table.cell(diagnostics, 1, 2, "Trend " + str.tostring(trend) + " | Pending " + str.tostring(pendingBOSDirection), bgcolor = panel, text_color = color.white)
    table.cell(diagnostics, 0, 3, "Long", bgcolor = panel, text_color = color.white)
    table.cell(diagnostics, 1, 3, longStatus, bgcolor = longSignal ? color.green : panel, text_color = color.white)
    table.cell(diagnostics, 0, 4, "Short", bgcolor = panel, text_color = color.white)
    table.cell(diagnostics, 1, 4, shortStatus, bgcolor = shortSignal ? color.green : panel, text_color = color.white)
    table.cell(diagnostics, 0, 5, "Filters", bgcolor = panel, text_color = color.white)
    table.cell(diagnostics, 1, 5, filterStatus, bgcolor = panel, text_color = color.white)
    table.cell(diagnostics, 0, 6, "Signals / trades", bgcolor = panel, text_color = color.white)
    table.cell(diagnostics, 1, 6, str.tostring(generatedSignals) + " / " + str.tostring(strategy.closedtrades) + " closed", bgcolor = generatedSignals > 0 and strategy.closedtrades == 0 ? color.orange : panel, text_color = color.white)
if barstate.islast and not showDiagnostics
    table.clear(diagnostics, 0, 0, 1, 6)
