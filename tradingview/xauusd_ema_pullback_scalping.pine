//@version=6
strategy(
     title = "XAUUSD Value Area Pullback Scalper",
     shorttitle = "Gold VA Scalp",
     overlay = true,
     initial_capital = 100000,
     currency = currency.USD,
     default_qty_type = strategy.fixed,
     default_qty_value = 1.0,
     pyramiding = 0,
     margin_long = 5,
     margin_short = 5,
     commission_type = strategy.commission.cash_per_contract,
     commission_value = 0.035,
     slippage = 3,
     calc_on_every_tick = true,
     calc_on_order_fills = true,
     process_orders_on_close = true)

// ──────────────────────────────────────────────────────────────
// INPUTS
// ──────────────────────────────────────────────────────────────

string GROUP_ENTRY = "Entry & Value Area"
int fastLength = input.int(21, "Fast EMA (Value Top)", minval = 2, group = GROUP_ENTRY)
int slowLength = input.int(50, "Slow EMA (Value Bottom)", minval = 3, group = GROUP_ENTRY)
int trendLength = input.int(200, "Macro Trend EMA", minval = 50, group = GROUP_ENTRY)
int rsiLength = input.int(7, "RSI Length", minval = 2, group = GROUP_ENTRY)
float rsiOversold = input.float(35, "RSI Oversold (Long exhaustion)", minval = 10, group = GROUP_ENTRY)
float rsiOverbought = input.float(65, "RSI Overbought (Short exhaustion)", minval = 50, group = GROUP_ENTRY)
float orderQuantity = input.float(1.0, "Order quantity", minval = 0.01, step = 0.01, group = GROUP_ENTRY)

string GROUP_EXIT = "Exit (ATR Dynamic)"
float pipSize = input.float(0.01, "Price per pip", minval = 0.00001, step = 0.01, group = GROUP_EXIT)
int exitAtrLength = input.int(14, "ATR length for exits", minval = 2, group = GROUP_EXIT)
float slAtrMult = input.float(1.5, "Stop loss ATR multiplier", minval = 0.5, step = 0.1, group = GROUP_EXIT)
bool usePartialTP = input.bool(true, "Use partial take profit (50% at TP1)", group = GROUP_EXIT)
float tp1AtrMult = input.float(1.5, "TP1 ATR multiplier", minval = 0.5, step = 0.1, group = GROUP_EXIT)
float tp2AtrMult = input.float(3.0, "TP2 ATR multiplier", minval = 0.5, step = 0.1, group = GROUP_EXIT)

string GROUP_TRAIL = "Trailing stop & Break-even"
bool useBreakEven = input.bool(true, "Enable break-even", group = GROUP_TRAIL)
float beAtrMult = input.float(1.0, "Break-even trigger (ATR mult)", minval = 0.2, step = 0.1, group = GROUP_TRAIL)
float beBufferPips = input.float(3, "Break-even buffer (pips)", minval = 0, step = 1, group = GROUP_TRAIL)
bool useTrailingStop = input.bool(true, "Enable trailing stop", group = GROUP_TRAIL)
float trailAtrMult = input.float(0.7, "Trail offset (ATR mult)", minval = 0.2, step = 0.1, group = GROUP_TRAIL)

string GROUP_FILTER = "Protection"
bool useVolumeConfirm = input.bool(true, "Require above-average volume", group = GROUP_FILTER)
int volumeLength = input.int(20, "Volume SMA length", minval = 5, group = GROUP_FILTER)
bool useDayGapProtection = input.bool(true, "Avoid daily market gap", group = GROUP_FILTER)
string dayGapBlockSession = input.session("1645-1810:23456", "Daily gap block window", group = GROUP_FILTER)
string dayGapCloseSession = input.session("1645-1700:23456", "Daily force-close window", group = GROUP_FILTER)
bool useWeekendProtection = input.bool(true, "Avoid weekend gap", group = GROUP_FILTER)
string gapTimezone = input.string("America/New_York", "Gap timezone", group = GROUP_FILTER)

// ──────────────────────────────────────────────────────────────
// INDICATORS
// ──────────────────────────────────────────────────────────────

float emaFast = ta.ema(close, fastLength)
float emaSlow = ta.ema(close, slowLength)
float emaMacro = ta.ema(close, trendLength)
float rsiValue = ta.rsi(close, rsiLength)
float exitAtr = ta.atr(exitAtrLength)
float avgVolume = ta.sma(volume, volumeLength)
float calculatedQuantity = math.max(orderQuantity, syminfo.mincontract)

// Dynamic distances
float target1Distance = math.max(exitAtr * tp1AtrMult, syminfo.mintick)
float target2Distance = math.max(exitAtr * tp2AtrMult, syminfo.mintick)
float stopDistance = math.max(exitAtr * slAtrMult, syminfo.mintick)
float beDistance = exitAtr * beAtrMult
float trailOffset = exitAtr * trailAtrMult
float beBuffer = beBufferPips * pipSize

// Gap protections
bool dayGapEntryBlocked = useDayGapProtection and not na(time(timeframe.period, dayGapBlockSession, gapTimezone))
bool dayGapForceClose = useDayGapProtection and not na(time(timeframe.period, dayGapCloseSession, gapTimezone))
bool weekendEntryBlocked = useWeekendProtection and not na(time(timeframe.period, "1630-2359:6", gapTimezone))
bool weekendForceClose = useWeekendProtection and not na(time(timeframe.period, "1645-1700:6", gapTimezone))
bool gapEntryBlocked = dayGapEntryBlocked or weekendEntryBlocked

// ──────────────────────────────────────────────────────────────
// VALUE AREA & EXHAUSTION LOGIC
// ──────────────────────────────────────────────────────────────

bool macroBullish = close > emaMacro and emaFast > emaMacro
bool macroBearish = close < emaMacro and emaFast < emaMacro

// Check if price pulled back into Value Area (between Fast and Slow EMA)
bool insideValueAreaLong = low <= emaFast and close >= emaSlow
bool insideValueAreaShort = high >= emaFast and close <= emaSlow

// Check Exhaustion
// RSI must have dipped below oversold within the last 5 bars during the pullback
bool rsiExhaustionLong = ta.lowest(rsiValue, 5) <= rsiOversold
bool rsiExhaustionShort = ta.highest(rsiValue, 5) >= rsiOverbought

// Price Action Trigger: Rejection of value area bottom and closing above fast EMA
bool bullTrigger = close > emaFast and close > open
bool bearTrigger = close < emaFast and close < open

bool volumeOk = not useVolumeConfirm or (volume > avgVolume)

// ──────────────────────────────────────────────────────────────
// ENTRY SIGNALS
// ──────────────────────────────────────────────────────────────

bool flat = strategy.position_size == 0
bool longSignal = barstate.isconfirmed and flat and not gapEntryBlocked and macroBullish and insideValueAreaLong and rsiExhaustionLong and bullTrigger and volumeOk
bool shortSignal = barstate.isconfirmed and flat and not gapEntryBlocked and macroBearish and insideValueAreaShort and rsiExhaustionShort and bearTrigger and volumeOk

if longSignal
    strategy.entry("Long", strategy.long, qty = calculatedQuantity, alert_message = "XAUUSD LONG")
if shortSignal
    strategy.entry("Short", strategy.short, qty = calculatedQuantity, alert_message = "XAUUSD SHORT")

// ──────────────────────────────────────────────────────────────
// EXIT MANAGEMENT
// ──────────────────────────────────────────────────────────────

var float activeStop = na
var float activeTarget = na
var float activeTarget2 = na
var float entryPrice = na
var bool breakEvenHit = false

bool newLong = strategy.position_size > 0 and strategy.position_size[1] <= 0
bool newShort = strategy.position_size < 0 and strategy.position_size[1] >= 0

if newLong
    entryPrice := strategy.position_avg_price
    activeStop := math.round_to_mintick(entryPrice - stopDistance)
    activeTarget := math.round_to_mintick(entryPrice + target1Distance)
    activeTarget2 := math.round_to_mintick(entryPrice + target2Distance)
    breakEvenHit := false

if newShort
    entryPrice := strategy.position_avg_price
    activeStop := math.round_to_mintick(entryPrice + stopDistance)
    activeTarget := math.round_to_mintick(entryPrice - target1Distance)
    activeTarget2 := math.round_to_mintick(entryPrice - target2Distance)
    breakEvenHit := false

// Break-even
if strategy.position_size > 0 and useBreakEven and not breakEvenHit and not na(entryPrice)
    if close >= entryPrice + beDistance
        activeStop := math.round_to_mintick(entryPrice + beBuffer)
        breakEvenHit := true
if strategy.position_size < 0 and useBreakEven and not breakEvenHit and not na(entryPrice)
    if close <= entryPrice - beDistance
        activeStop := math.round_to_mintick(entryPrice - beBuffer)
        breakEvenHit := true

// Trailing stop
if strategy.position_size > 0 and useTrailingStop and breakEvenHit and not na(activeStop)
    float newTrailStop = math.round_to_mintick(close - trailOffset)
    if newTrailStop > activeStop
        activeStop := newTrailStop
if strategy.position_size < 0 and useTrailingStop and breakEvenHit and not na(activeStop)
    float newTrailStop = math.round_to_mintick(close + trailOffset)
    if newTrailStop < activeStop
        activeStop := newTrailStop

bool gapForceClose = strategy.position_size != 0 and (weekendForceClose or dayGapForceClose)

if gapForceClose
    string exitComment = weekendForceClose ? "WEEKEND EXIT" : "DAY GAP EXIT"
    strategy.close_all(comment = exitComment, alert_message = exitComment)

if not gapForceClose and strategy.position_size > 0 and not na(activeStop) and not na(activeTarget)
    if usePartialTP
        strategy.exit("TP1 Long", "Long", qty_percent = 50, stop = activeStop, limit = activeTarget, alert_message = "LONG TP1")
        strategy.exit("TP2 Long", "Long", stop = activeStop, limit = activeTarget2, alert_message = "LONG TP2")
    else
        strategy.exit("Long exit", "Long", stop = activeStop, limit = activeTarget, alert_message = "LONG EXIT")

if not gapForceClose and strategy.position_size < 0 and not na(activeStop) and not na(activeTarget)
    if usePartialTP
        strategy.exit("TP1 Short", "Short", qty_percent = 50, stop = activeStop, limit = activeTarget, alert_message = "SHORT TP1")
        strategy.exit("TP2 Short", "Short", stop = activeStop, limit = activeTarget2, alert_message = "SHORT TP2")
    else
        strategy.exit("Short exit", "Short", stop = activeStop, limit = activeTarget, alert_message = "SHORT EXIT")

if strategy.position_size == 0 and strategy.position_size[1] != 0
    activeStop := na
    activeTarget := na
    activeTarget2 := na
    entryPrice := na
    breakEvenHit := false

// ──────────────────────────────────────────────────────────────
// PLOTS & DASHBOARD
// ──────────────────────────────────────────────────────────────

plot(emaFast, "Fast EMA", color = color.orange, linewidth = 2)
plot(emaSlow, "Slow EMA", color = color.blue, linewidth = 2)
plot(emaMacro, "Macro Trend EMA 200", color = color.new(color.white, 50), linewidth = 2)

plot(strategy.position_size != 0 ? activeStop : na, "Stop loss", color = color.red, style = plot.style_linebr, linewidth = 2)
plot(strategy.position_size != 0 ? activeTarget : na, "TP1", color = color.lime, style = plot.style_linebr, linewidth = 2)
plot(strategy.position_size != 0 ? activeTarget2 : na, "TP2", color = color.green, style = plot.style_linebr, linewidth = 2)
plot(strategy.position_size != 0 and breakEvenHit ? entryPrice : na, "Entry (BE active)", color = color.new(color.yellow, 40), style = plot.style_linebr, linewidth = 1)
plotshape(longSignal, "Long entry", shape.triangleup, location.belowbar, color.lime, size = size.tiny, text = "BUY")
plotshape(shortSignal, "Short entry", shape.triangledown, location.abovebar, color.red, size = size.tiny, text = "SELL")

var table status = table.new(position.top_right, 2, 7, border_width = 1)
if barstate.islast
    int totalTrades = strategy.closedtrades
    int wins = strategy.wintrades
    float winRate = totalTrades > 0 ? wins / totalTrades * 100 : 0
    float profitFactor = strategy.grossloss != 0 ? math.abs(strategy.grossprofit / strategy.grossloss) : 0

    color headerBg = strategy.netprofit >= 0 ? color.new(#00897B, 15) : color.new(#E53935, 15)
    table.cell(status, 0, 0, "VA PULLBACK SCALP", bgcolor = color.new(#1565C0, 15), text_color = color.white, text_size = size.small)
    table.cell(status, 1, 0, macroBullish ? "UPTREND" : macroBearish ? "DOWNTREND" : "FLAT", bgcolor = headerBg, text_color = color.white, text_size = size.small)

    table.cell(status, 0, 1, "RSI (7)", text_size = size.tiny)
    table.cell(status, 1, 1, str.tostring(rsiValue, "#.0"), text_size = size.tiny, text_color = rsiValue < rsiOversold ? color.lime : rsiValue > rsiOverbought ? color.red : color.white)

    table.cell(status, 0, 2, "ATR (pips)", text_size = size.tiny)
    table.cell(status, 1, 2, str.tostring(exitAtr / pipSize, "#.0"), text_size = size.tiny)

    table.cell(status, 0, 3, "CLOSED TRADES", text_size = size.tiny)
    table.cell(status, 1, 3, str.tostring(totalTrades), text_size = size.tiny)

    table.cell(status, 0, 4, "WIN RATE", text_size = size.tiny)
    table.cell(status, 1, 4, str.tostring(winRate, "#.1") + "%", text_size = size.tiny, text_color = winRate >= 45 ? color.green : color.red)

    table.cell(status, 0, 5, "PROFIT FACTOR", text_size = size.tiny)
    table.cell(status, 1, 5, str.tostring(profitFactor, "#.##"), text_size = size.tiny, text_color = profitFactor >= 1.3 ? color.green : color.red)

    table.cell(status, 0, 6, "NET PROFIT", text_size = size.tiny)
    table.cell(status, 1, 6, "$" + str.tostring(strategy.netprofit, "#,###.##"), text_size = size.tiny, text_color = strategy.netprofit >= 0 ? color.green : color.red)
